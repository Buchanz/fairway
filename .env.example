# Public backend origin for native clients; not a secret.
EXPO_PUBLIC_API_URL=https://your-fairway-backend.example
# Server settings. Use 0.0.0.0 only when exposing through a hosting service or LAN.
PORT=8787
HOST=127.0.0.1
# Provider secrets belong only in server/hosting environment variables.
# No provider credentials or Android Maps key are currently configured here.
# Public Supabase project settings. NEVER use a service-role/secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Android native builds only. Restrict this key to the Android package/signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
