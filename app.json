{
  "expo": {
    "name": "Fairway",
    "slug": "fairway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buchanzsteam.fairway",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Fairway to find nearby golf courses and measure distances from your location during a round."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fairway to choose a profile photo from your photo library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image"
    ],
    "scheme": "fairway",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc0b8fe2-b3d4-4ff3-8002-c37024b7d6b4"
      }
    },
    "owner": "buchanzs-team"
  }
}
