{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "fairway://account"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "fairway://account"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "RR2SM3NWCN",
        "ascAppId": "6825213619"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
